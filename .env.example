# Copy this file to .env.local (NOT .env) and fill in the values.
# .env.local is git-ignored by the Vite template (*.local). Never commit real values.
#
# Firebase: Firebase Console > Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=campuscart-1887f
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Public URL of your Supabase Edge Functions (no trailing slash):
# https://<your-project-ref>.supabase.co/functions/v1
VITE_SUPABASE_FUNCTIONS_URL=
#
# There is deliberately NO Supabase key and NO admin identifier here. The browser needs neither.
# Server secrets (service-role key, attestor password, allowed origins) live only in Supabase.
